{
  "description": "FSI \u2014 reentrenamiento (features UC + MLflow + registro UC con compuerta champion/challenger) y scoring batch de siniestros abiertos",
  "email_notifications": {},
  "format": "MULTI_TASK",
  "job_clusters": [
    {
      "job_cluster_key": "ml_cluster",
      "new_cluster": {
        "azure_attributes": {
          "availability": "ON_DEMAND_AZURE"
        },
        "custom_tags": {
          "ResourceClass": "SingleNode",
          "proyecto": "seguros_demo"
        },
        "data_security_mode": "SINGLE_USER",
        "enable_elastic_disk": true,
        "node_type_id": "Standard_DS4_v2",
        "num_workers": 0,
        "single_user_name": "<tu_usuario>",
        "spark_conf": {
          "spark.databricks.cluster.profile": "singleNode",
          "spark.master": "local[*]"
        },
        "spark_version": "16.4.x-cpu-ml-scala2.12"
      }
    }
  ],
  "max_concurrent_runs": 1,
  "name": "seguros_fraude_siniestros_mlops",
  "queue": {
    "enabled": true
  },
  "tags": {
    "caso_uso": "fraude_siniestros",
    "proyecto": "seguros_demo"
  },
  "tasks": [
    {
      "disabled": false,
      "email_notifications": {},
      "job_cluster_key": "ml_cluster",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<tu_usuario>/seguros_demo/ml/01_features_entrenamiento",
        "source": "WORKSPACE"
      },
      "run_if": "ALL_SUCCESS",
      "task_key": "features_entrenamiento",
      "timeout_seconds": 5400
    },
    {
      "depends_on": [
        {
          "task_key": "features_entrenamiento"
        }
      ],
      "disabled": false,
      "email_notifications": {},
      "job_cluster_key": "ml_cluster",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<tu_usuario>/seguros_demo/ml/02_scoring_batch",
        "source": "WORKSPACE"
      },
      "run_if": "ALL_SUCCESS",
      "task_key": "scoring_batch",
      "timeout_seconds": 3600
    },
    {
      "depends_on": [
        {
          "task_key": "scoring_batch"
        }
      ],
      "description": "Reverse ETL 1/2: MERGE del scoring a bandeja_siu_serving (Delta con CDF, sin PII)",
      "disabled": false,
      "email_notifications": {},
      "run_if": "ALL_SUCCESS",
      "sql_task": {
        "file": {
          "path": "/Workspace/Users/<tu_usuario>/seguros_demo/lakebase/01_serving_bandeja.sql",
          "source": "WORKSPACE"
        },
        "warehouse_id": "<WAREHOUSE_ID>"
      },
      "task_key": "serving_bandeja_siu",
      "timeout_seconds": 0
    },
    {
      "depends_on": [
        {
          "task_key": "serving_bandeja_siu"
        }
      ],
      "description": "Reverse ETL 2/2: sincroniza la synced table de Lakebase seguros-siu (serving.bandeja_siu) de forma incremental",
      "disabled": false,
      "email_notifications": {},
      "pipeline_task": {
        "full_refresh": false,
        "pipeline_id": "<UUID>"
      },
      "run_if": "ALL_SUCCESS",
      "task_key": "sync_lakebase_bandeja",
      "timeout_seconds": 0
    }
  ],
  "timeout_seconds": 0,
  "webhook_notifications": {}
}